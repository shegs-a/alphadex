# AlphaDex Scout — example configuration
#
# Copy to .env and fill in real values. NEVER commit .env.
# .env.example documents WHAT is configurable; it must not contain real secrets.
#
# Variables are added sprint-by-sprint. Sprint 00 (foundation) introduces the
# core application settings below; database, providers, and scan settings are
# activated in later sprints (kept here, commented, so the shape is known).

# ── Application ────────────────────────────────────────────────────────────
APP_ENV=local                 # local | staging | production
APP_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=alphadex
POSTGRES_PASSWORD=change_me            # secret — real value only in .env
POSTGRES_DB=alphadex
POSTGRES_HOST=db                       # 'db' inside Docker, 'localhost' locally
POSTGRES_PORT=5432
# Optional: set DATABASE_URL to override the assembled POSTGRES_* URL entirely.
# DATABASE_URL=postgresql+psycopg://alphadex:change_me@db:5432/alphadex

# ── Market data provider (Sprint 02) ───────────────────────────────────────
# Provider API keys are secrets — set real values only in .env.
MARKET_DATA_PROVIDER=coingecko
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# COINGECKO_API_KEY=                    # optional; demo/free tier works without
PROVIDER_TIMEOUT_SECONDS=20

# Asset universe (configurable — never hard-coded). An explicit comma-separated
# list of provider ids wins; otherwise the top-N assets by market cap are used.
# MARKET_UNIVERSE_IDS=bitcoin,ethereum,solana
MARKET_UNIVERSE_TOP_N=50

# ── Fundamental data provider (Sprint 03) ──────────────────────────────────
FUNDAMENTAL_DATA_PROVIDER=defillama
DEFILLAMA_BASE_URL=https://api.llama.fi
# DEFILLAMA_API_KEY=                     # optional; public API works without

# ── Opportunity Scanner (Sprint 04) ────────────────────────────────────────
# Inclusion gates (a candidate must pass all of these).
SCAN_MARKET_CAP_MIN=10000000            # market-cap floor (USD)
# SCAN_MARKET_CAP_MAX=                   # optional market-cap ceiling (USD)
SCAN_MIN_VOLUME_24H=100000              # minimum 24h volume (USD)
SCAN_FRESHNESS_MAX_HOURS=48             # market data must be newer than this
SCAN_REQUIRE_FUNDAMENTALS=false        # if true, no-fundamentals → insufficient_data
# Screen Score normalization references (log-scaled signals).
SCAN_REF_FEES_30D=100000000
SCAN_REF_VOLUME_24H=1000000000
# Preliminary Screen Score weights (must sum to 1.0; NOT the Alpha Score).
SCAN_WEIGHT_ACTIVITY=0.4
SCAN_WEIGHT_LIQUIDITY=0.3
SCAN_WEIGHT_MOMENTUM=0.3

# ── Divergence Engine (Sprint 05) ───────────────────────────────────────────
DIVERGENCE_SCOPE=candidates             # "candidates" (latest scan) or "all"
DIVERGENCE_MIN_HISTORY_DAYS=5           # Track B needs two obs at least this apart
DIVERGENCE_THRESHOLD=0.15               # score to classify fundamental_divergence
DIVERGENCE_WEAKENING_THRESHOLD=-0.15    # score at/below which → thesis_weakening
DIVERGENCE_MIN_FUNDAMENTALS_IMPROVEMENT=0.05
# Divergence score component weights (must sum to 1.0; a component, NOT alpha).
DIVERGENCE_WEIGHT_GAP=0.7
DIVERGENCE_WEIGHT_VALUATION=0.3

# ── Notifications (Sprint 09) ──────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=                    # secret
# TELEGRAM_CHAT_ID=

# ── Scoring / scan settings (Sprint 04+) ───────────────────────────────────
# Default Alpha Score weights live in application config, not here; override
# only when intentionally tuning. Values must sum to 1.0.
# ALPHA_WEIGHT_ECONOMIC_GROWTH=0.25
# ALPHA_WEIGHT_DIVERGENCE=0.20
# ALPHA_WEIGHT_VALUATION=0.15
# ALPHA_WEIGHT_TOKEN_VALUE_CAPTURE=0.15
# ALPHA_WEIGHT_MARKET_STRENGTH=0.10
# ALPHA_WEIGHT_TOKENOMICS=0.10
# ALPHA_WEIGHT_TECHNICAL_SETUP=0.05
